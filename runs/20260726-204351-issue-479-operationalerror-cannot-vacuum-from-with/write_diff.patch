@@ -1170,6 +1170,18 @@ def test_vacuum(fresh_db):
     fresh_db.vacuum()
 
 
+def test_vacuum_inside_transaction_raises(fresh_db):
+    from sqlite_utils.db import TransactionError
+
+    fresh_db["data"].insert({"id": 1}, pk="id")
+    with pytest.raises(TransactionError):
+        with fresh_db.atomic():
+            fresh_db["data"].insert({"id": 2}, pk="id")
+            fresh_db.vacuum()
+    # The atomic() block must have rolled back cleanly
+    assert [r["id"] for r in fresh_db["data"].rows] == [1]
+
+
