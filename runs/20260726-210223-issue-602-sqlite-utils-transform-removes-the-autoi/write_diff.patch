diff --git a/tests/test_transform.py b/tests/test_transform.py
index 362f1ca..1d653d7 100644
--- a/tests/test_transform.py
+++ b/tests/test_transform.py
@@ -226,6 +226,37 @@ def test_transform_rename_pk(fresh_db):
     )
 
 
+def test_transform_preserves_autoincrement(fresh_db):
+    # https://github.com/simonw/sqlite-utils/issues/602
+    fresh_db.execute(
+        "CREATE TABLE mytable (col1 INTEGER PRIMARY KEY AUTOINCREMENT, col2 TEXT NOT NULL)"
+    )
+    table = fresh_db["mytable"]
+    table.insert({"col2": "hello"})
+    table.transform(rename={"col2": "renamedcol2"})
+    assert (
+        table.schema
+        == 'CREATE TABLE "mytable" (\n   "col1" INTEGER PRIMARY KEY AUTOINCREMENT,\n   "renamedcol2" TEXT NOT NULL\n)'
+    )
+    # sqlite_sequence tracking should still work after the transform
+    table.delete(1)
+    table.insert({"renamedcol2": "world"})
+    assert [row["col1"] for row in table.rows] == [2]
+
+
+def test_transform_drops_autoincrement_when_pk_changes(fresh_db):
+    fresh_db.execute(
+        "CREATE TABLE mytable (col1 INTEGER PRIMARY KEY AUTOINCREMENT, col2 TEXT NOT NULL)"
+    )
+    table = fresh_db["mytable"]
+    table.insert({"col2": "hello"})
+    table.transform(pk="col2")
+    assert (
+        table.schema
+        == 'CREATE TABLE "mytable" (\n   "col1" INTEGER,\n   "col2" TEXT PRIMARY KEY NOT NULL\n)'
+    )
+
+
