diff --git a/tests/test_cli.py b/tests/test_cli.py
index a2135b0..50c98fe 100644
--- a/tests/test_cli.py
+++ b/tests/test_cli.py
@@ -59,6 +59,28 @@ def test_tables(db_path):
     assert '[{"table": "Gosh"},\n {"table": "Gosh2"}]' == result.output.strip()
 
 
+def test_tables_specific_tables(db_path):
+    db = Database(db_path)
+    with db.conn:
+        db["lots"].insert_all([{"id": i, "age": i + 1} for i in range(30)])
+    result = CliRunner().invoke(
+        cli.cli, ["tables", db_path, "Gosh2", "lots"], catch_exceptions=False
+    )
+    assert '[{"table": "Gosh2"},\n {"table": "lots"}]' == result.output.strip()
+
+
+def test_tables_specific_tables_counts(db_path):
+    db = Database(db_path)
+    with db.conn:
+        db["lots"].insert_all([{"id": i, "age": i + 1} for i in range(30)])
+    result = CliRunner().invoke(
+        cli.cli,
+        ["tables", db_path, "lots", "--counts"],
+        catch_exceptions=False,
+    )
+    assert '[{"table": "lots", "count": 30}]' == result.output.strip()
+
+
