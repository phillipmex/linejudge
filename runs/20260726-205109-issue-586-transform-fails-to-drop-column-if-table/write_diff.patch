diff --git a/tests/test_transform.py b/tests/test_transform.py
index 362f1ca..f34ce8f 100644
--- a/tests/test_transform.py
+++ b/tests/test_transform.py
@@ -904,3 +904,33 @@ def test_transform_with_unique_constraint_implicit_index(fresh_db):
         "You must manually drop this index prior to running this transformation and manually recreate the new index after running this transformation."
         in str(excinfo.value)
     )
+
+
+def test_transform_recreate_views(fresh_db):
+    # https://github.com/simonw/sqlite-utils/issues/586
+    dogs = fresh_db["dogs"]
+    dogs.insert({"id": 1, "name": "Cleo", "age": "5", "status": "good"}, pk="id")
+    fresh_db.create_view(
+        "good_dogs", "select id, name from dogs where age = '5'"
+    )
+    dogs.transform(drop={"status"}, recreate_views=True)
+    assert fresh_db.view_names() == ["good_dogs"]
+    assert list(fresh_db["good_dogs"].rows) == [{"id": 1, "name": "Cleo"}]
+    assert dogs.columns_dict == {"id": int, "name": str, "age": str}
+
+
+def test_transform_sql_recreate_views(fresh_db):
+    dogs = fresh_db["dogs"]
+    dogs.insert({"id": 1, "name": "Cleo", "age": "5"}, pk="id")
+    fresh_db.create_view("good_dogs", "select id, name from dogs")
+    sql = dogs.transform_sql(
+        drop={"age"}, tmp_suffix="suffix", recreate_views=True
+    )
+    assert sql == [
+        'DROP VIEW "good_dogs";',
+        'CREATE TABLE "dogs_new_suffix" (\n   "id" INTEGER PRIMARY KEY,\n   "name" TEXT\n);',
+        'INSERT INTO "dogs_new_suffix" ("rowid", "id", "name")\n   SELECT "rowid", "id", "name" FROM "dogs";',
+        'DROP TABLE "dogs";',
+        'ALTER TABLE "dogs_new_suffix" RENAME TO "dogs";',
+        'CREATE VIEW "good_dogs" AS select id, name from dogs;',
+    ]
