+    db = Database(db_path)
+    with db.conn:
+        db["dogs"].insert(
+            {"id": 1, "age": 4, "name": "Cleo"},
+            not_null={"age"},
+            defaults={"age": 1},
+            pk="id",
+        )
+        db.create_view("dogs_view", "select id, name from dogs")
+
+    result = CliRunner().invoke(
+        cli.cli,
+        ["transform", db_path, "dogs", "--drop", "age", "--recreate-views"],
+    )
+
+    assert result.exit_code == 0, result.output
+    assert db.view_names() == ["dogs_view"]
+    assert list(db["dogs_view"].rows) == [{"id": 1, "name": "Cleo"}]
+
