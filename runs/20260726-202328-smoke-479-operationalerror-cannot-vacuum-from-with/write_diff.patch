+def test_vacuum_raises_error_within_transaction(fresh_db):
+    fresh_db["data"].insert({"foo": "foo", "bar": "bar"})
+    fresh_db.begin()
+    with pytest.raises(TransactionError) as ex:
+        fresh_db.vacuum()
+    assert "vacuum()" in str(ex.value)
+    assert "transaction" in str(ex.value).lower()
+    fresh_db.rollback()
+
+
+def test_vacuum_raises_error_within_atomic(fresh_db):
+    fresh_db["data"].insert({"foo": "foo", "bar": "bar"})
+    with pytest.raises(TransactionError) as ex:
+        with fresh_db.atomic():
+            fresh_db.vacuum()
+    assert "vacuum()" in str(ex.value)
+
+
