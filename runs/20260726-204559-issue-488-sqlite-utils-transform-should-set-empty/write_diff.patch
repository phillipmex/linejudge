+def test_transform_type_conversion_sets_empty_strings_to_null(fresh_db):
+    # https://github.com/simonw/sqlite-utils/issues/488
+    test = fresh_db["test"]
+    test.insert_all(
+        [
+            {"id": "1", "age": "3", "weight": "2.5"},
+            {"id": "2", "age": "", "weight": ""},
+        ]
+    )
+    test.transform(types={"age": int, "weight": float})
+    assert list(test.rows) == [
+        {"id": "1", "age": 3, "weight": 2.5},
+        {"id": "2", "age": None, "weight": None},
+    ]
+
+
 def test_transform_not_null(fresh_db):
     dogs = fresh_db["dogs"]
     dogs.insert({"id": 1, "name": "Cleo", "age": "5"}, pk="id")
