diff --git a/sqlite_utils/db.py b/sqlite_utils/db.py
index e97b7d9..782223a 100644
--- a/sqlite_utils/db.py
+++ b/sqlite_utils/db.py
@@ -2866,10 +2866,26 @@ class Table(Queryable):
         if "rowid" not in new_cols:
             new_cols.insert(0, "rowid")
             old_cols.insert(0, "rowid")
+
+        # Columns whose type is being explicitly converted to INTEGER/FLOAT/REAL
+        # should have empty strings turned into NULL, otherwise SQLite's type
+        # affinity leaves them as the empty string instead of converting them
+        numeric_sql_types = {"INTEGER", "FLOAT", "REAL"}
+        columns_needing_nullif = {
+            column
+            for column in old_cols
+            if column in types and COLUMN_TYPE_MAPPING.get(types[column]) in numeric_sql_types
+        }
+
+        def old_col_sql(column):
+            if column in columns_needing_nullif:
+                return "nullif({}, '')".format(quote_identifier(column))
+            return quote_identifier(column)
+
         copy_sql = "INSERT INTO {} ({new_cols})\n   SELECT {old_cols} FROM {};".format(
             quote_identifier(new_table_name),
             quote_identifier(self.name),
-            old_cols=", ".join(quote_identifier(col) for col in old_cols),
+            old_cols=", ".join(old_col_sql(col) for col in old_cols),
             new_cols=", ".join(quote_identifier(col) for col in new_cols),
         )
         sqls.append(copy_sql)
