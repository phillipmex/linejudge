+def test_update_wrapper_counts_bytes_not_characters():
+    # https://github.com/simonw/sqlite-utils/issues/439
+    # Progress is measured in bytes (against the file size on disk), so the
+    # wrapper must report the encoded byte length of each chunk it yields,
+    # not its decoded character length - otherwise multi-byte encodings such
+    # as utf-16 make the progress bar wildly inaccurate.
+    content = "id,name\n1,Cleo\n2,Cardi\n"
+    encoded = content.encode("utf-16-le")
+    updates = []
+    decoded = io.TextIOWrapper(io.BytesIO(encoded), encoding="utf-16-le")
+    wrapper = utils.UpdateWrapper(decoded, updates.append, encoding="utf-16-le")
+    list(wrapper)
+    assert sum(updates) == len(encoded)
+
