+def test_transform_preserves_check_constraint(fresh_db):
+    fresh_db.execute("""
+        CREATE TABLE dogs (
+            id INTEGER PRIMARY KEY,
+            name TEXT,
+            age INTEGER CHECK (age >= 0)
+        );
+    """)
+    dogs = fresh_db["dogs"]
+    dogs.insert({"id": 1, "name": "Cleo", "age": 5})
+
+    dogs.transform(types={"name": str})
+
+    assert dogs.schema == (
+        'CREATE TABLE "dogs" (\n'
+        '   "id" INTEGER PRIMARY KEY,\n'
+        '   "name" TEXT,\n'
+        '   "age" INTEGER,\n'
+        "   CHECK (age >= 0)\n"
+        ")"
+    )
+    with pytest.raises(sqlite3.IntegrityError):
+        dogs.insert({"id": 2, "name": "Rex", "age": -1})
+
