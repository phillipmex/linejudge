+def test_transform_compound_unique_constraint_implicit_index(fresh_db):
+    fresh_db.execute("""
+        CREATE TABLE dogs (
+            id INTEGER PRIMARY KEY,
+            name TEXT,
+            age INTEGER,
+            UNIQUE (name, age)
+        );
+    """)
+    dogs = fresh_db["dogs"]
+    dogs.insert({"id": 1, "name": "Cleo", "age": 5})
+
+    dogs.transform(rename={"age": "dog_age"})
+
+    assert dogs.schema == (
+        'CREATE TABLE "dogs" (\n'
+        '   "id" INTEGER PRIMARY KEY,\n'
+        '   "name" TEXT,\n'
+        '   "dog_age" INTEGER,\n'
+        '   UNIQUE ("name", "dog_age")\n'
+        ")"
+    )
+    with pytest.raises(sqlite3.IntegrityError):
+        dogs.insert({"id": 2, "name": "Cleo", "dog_age": 5})
+    # Different dog_age should be fine
+    dogs.insert({"id": 3, "name": "Cleo", "dog_age": 6})
+
