+_CHECK_KEYWORD_RE = re.compile(r"\bCHECK\b", re.IGNORECASE)
+_IDENTIFIER_WORD_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
+_QUOTE_PAIRS = {'"': '"', "`": "`", "[": "]"}
+
+
+def _mask_quoted_regions(sql: str) -> str:
+    """
+    Return a copy of ``sql`` with the contents of every quoted region
+    (string literals and quoted identifiers) replaced with ``x`` characters,
+    preserving the original length and the position of everything else.
+    Used so that keyword and paren-matching scans do not get confused by
+    ``CHECK``-like text or parentheses that appear inside a string literal.
+    """
+    chars = list(sql)
+    i, n = 0, len(sql)
+    quote_chars = {"'", *_QUOTE_PAIRS.keys()}
+    while i < n:
+        ch = sql[i]
+        if ch in quote_chars:
+            end_char = _QUOTE_PAIRS.get(ch, "'")
+            start = i
+            j = i + 1
+            while j < n:
+                if sql[j] == end_char:
+                    if j + 1 < n and sql[j + 1] == end_char:
+                        j += 2
+                        continue
+                    j += 1
+                    break
+                j += 1
+            for k in range(start, min(j, n)):
+                chars[k] = "x"
+            i = j
+        else:
+            i += 1
+    return "".join(chars)
+
+
+def _extract_check_constraints(create_table_sql: str) -> List[str]:
+    """
+    Given the SQL of a ``CREATE TABLE`` statement, return a list of the raw
+    text of every ``CHECK (...)`` constraint it contains (including the
+    outer parentheses, excluding the ``CHECK`` keyword itself). SQLite does
+    not expose check constraints via any PRAGMA, so they can only be
+    recovered by parsing the original SQL.
+    """
+    masked = _mask_quoted_regions(create_table_sql)
+    results = []
+    for match in _CHECK_KEYWORD_RE.finditer(masked):
+        pos = match.end()
+        while pos < len(masked) and masked[pos].isspace():
+            pos += 1
+        if pos >= len(masked) or masked[pos] != "(":
+            continue
+        depth = 0
+        j = pos
+        while j < len(masked):
+            if masked[j] == "(":
+                depth += 1
+            elif masked[j] == ")":
+                depth -= 1
+                if depth == 0:
+                    break
+            j += 1
+        else:
+            continue  # pragma: no cover - unbalanced parens, malformed SQL
+        results.append(create_table_sql[pos : j + 1])
+    return results
+
+
+def _rewrite_check_expression(
+    expr: str, rename_folded: Dict[str, str], drop_folded: Set[str]
+) -> Tuple[str, bool]:
+    """
+    Rewrite column references within a ``CHECK (...)`` expression to account
+    for renamed columns, and report whether it references a dropped column.
+
+    Bare and quoted identifiers that case-insensitively match a column name
+    are treated as column references, unless immediately followed by ``(``
+    in which case they are treated as a function call instead - this means
+    a column named e.g. ``length`` will not be confused with a reference to
+    the ``length()`` SQL function.
+
+    Returns a tuple of ``(rewritten_expression, references_dropped_column)``.
+    """
+    out = []
+    references_dropped = False
+    i, n = 0, len(expr)
+    while i < n:
+        ch = expr[i]
+        if ch == "'":
+            j = i + 1
+            while j < n:
+                if expr[j] == "'":
+                    if j + 1 < n and expr[j + 1] == "'":
+                        j += 2
+                        continue
+                    j += 1
+                    break
+                j += 1
+            out.append(expr[i:j])
+            i = j
+            continue
+        if ch in _QUOTE_PAIRS:
+            end_char = _QUOTE_PAIRS[ch]
+            j = i + 1
+            while j < n:
+                if expr[j] == end_char:
+                    if j + 1 < n and expr[j + 1] == end_char:
+                        j += 2
+                        continue
+                    j += 1
+                    break
+                j += 1
+            inner = expr[i + 1 : j - 1] if j <= n and expr[j - 1] == end_char else expr[i + 1 : j]
+            inner = inner.replace(end_char * 2, end_char)
+            folded = fold_identifier_case(inner)
+            if folded in drop_folded:
+                references_dropped = True
+            if folded in rename_folded:
+                new_name = rename_folded[folded]
+                out.append(ch + new_name.replace(end_char, end_char * 2) + end_char)
+            else:
+                out.append(expr[i:j])
+            i = j
+            continue
+        match = _IDENTIFIER_WORD_RE.match(expr, i)
+        if match:
+            word = match.group(0)
+            end = match.end()
+            k = end
+            while k < n and expr[k] in " \t\r\n":
+                k += 1
+            is_call = k < n and expr[k] == "("
+            folded = fold_identifier_case(word)
+            if not is_call and folded in drop_folded:
+                references_dropped = True
+                out.append(word)
+            elif not is_call and folded in rename_folded:
+                out.append(rename_folded[folded])
+            else:
+                out.append(word)
+            i = end
+            continue
+        out.append(ch)
+        i += 1
+    return "".join(out), references_dropped
+
